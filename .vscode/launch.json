{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ipfixprobe (pcap input)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/core/ipfixprobe",
            "args": [
                "-L", "${workspaceFolder}/build/src/plugins",
                "-i", "pcap;file=tests/http-get.pcap",
                "-o", "text"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerArgs": "-q --tty=/dev/null",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
        },
        {
            "name": "ipfixprobe (dpdk input)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/core/ipfixprobe",
            "args": [
                "-L", "${workspaceFolder}/build/src/plugins",
                "-i", "dpdk@0;p=0;q=1;b=64;s;eal=-a 0000:08:00.0",
                "-i", "dpdk@1;",
                "-o", "text"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerArgs": "-q --tty=/dev/null",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
        },
        {
            "name": "ipfixprobe (attach to pid)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/src/core/ipfixprobe",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
